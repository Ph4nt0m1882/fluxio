{
  "name": "@fluxio/viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-dependency HTML5 Canvas 2D renderer and interactive toolbar for Fluxio",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "esbuild web/src/index.ts --bundle --minify --format=iife --global-name=Fluxio --target=es2020 --outfile=src/fluxio/_assets/viewer.bundle.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
